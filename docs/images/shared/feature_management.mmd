---
config:
  look: handDrawn
  flowchart:
    wrappingWidth: 400
---
graph TB;
    %% How classic and learned local features are created, run and matched
    linkStyle default stroke:#021526,stroke-width:1px,font-size:16px;

    classDef config fill:#FFFACD,stroke:#E1A100,stroke-width:1.5px,font-size:16px;
    classDef factory fill:#D1F0FF,stroke:#0077B6,stroke-width:1.5px,font-size:16px;
    classDef manager fill:#EAD7F3,stroke:#6A0DAD,stroke-width:1.5px,font-size:16px;
    classDef classic fill:#D6FFD6,stroke:#218380,stroke-width:1.5px,font-size:16px;
    classDef learned fill:#FFE3F1,stroke:#C71585,stroke-width:1.5px,font-size:16px;
    classDef output fill:#FAFAFA,stroke:#888888,stroke-width:1.5px,stroke-dasharray:6 4,font-size:16px;

    Preset["FeatureTrackerConfigs preset<br>detector_type, descriptor_type,<br>num_features, tracker_type"];
    TrackerFactory["feature_tracker_factory()"];
    Tracker["FeatureTracker<br>DescriptorFeatureTracker / LkFeatureTracker"];
    DFTracker["LoftrFeatureTracker / Mast3rFeatureTracker<br>(LOFTR, ROMA, TINY_ROMA, MAST3R)"];
    Manager["FeatureManager<br>dispatch on detector_type<br>and descriptor_type"];
    Adaptors["PyramidAdaptor<br>BlockAdaptor"];

    subgraph classicbox["Classic features: always available"]
        CV["OpenCV factories<br>cv2.ORB_create, SIFT_create,<br>AKAZE_create, xfeatures2d.*"];
        CvWrap["Small pyslam wrappers<br>Orbslam2Feature2D (C++),<br>RootSIFTFeature2D, ShiTomasiDetector"];
    end

    subgraph learnedbox["Learned features: imported on first use"]
        Lazy["_wrapper(name)<br>lazy import of the wrapper module<br>(torch, TF, kornia, vendor repo)"];
        Base["BaseFeature2D subclasses<br>SuperPointFeature2D, AlikedFeature2D,<br>DeDoDeFeature2D, RddFeature2D, ..."];
        Persistent["PersistentThreadAdaptor<br>one inference thread<br>(torch models)"];
    end

    Output[("same interface and output<br>detect / compute / detectAndCompute<br>cv2.KeyPoint[] + descriptors")];
    Info[("FeatureInfo<br>norm_type: Hamming or L2<br>max_descriptor_distance")];
    MatcherFactory["feature_matcher_factory()"];
    Matcher["FeatureMatcher<br>BF / FLANN: any descriptor<br>XFeatMatcher / LightGlueMatcher: learned"];
    DFMatcher["Detector-free matchers<br>LoFTRMatcher, Mast3RMatcher,<br>DetectorFreeMatcher (RoMa, tiny-RoMa)"];

    Preset --> TrackerFactory;
    TrackerFactory -->|"`_descriptor or LK tracker_`"| Tracker;
    TrackerFactory -->|"`_detector-free tracker_`"| DFTracker;
    Tracker -->|"`_has-a_`"| Manager;
    Tracker -->|"`_has-a_`"| Matcher;
    DFTracker -->|"`_has-a_`"| DFMatcher;
    Manager -->|"`_has-a_`"| Adaptors;

    Manager -->|"`_classic type_`"| CV;
    Manager -->|"`_classic type_`"| CvWrap;
    Manager -->|"`_learned type_`"| Lazy;
    Lazy --> Base;
    Base -->|"`_wrapped by_`"| Persistent;

    CV --> Output;
    CvWrap --> Output;
    Persistent --> Output;
    Output -->|"`_descriptor type_`"| Info;
    Output --> Matcher;
    Info --> Matcher;
    MatcherFactory -->|"`_creates_`"| Matcher;
    MatcherFactory -->|"`_creates_`"| DFMatcher;


    class Preset config;
    class TrackerFactory,MatcherFactory factory;
    class Tracker,DFTracker,Manager,Adaptors,Matcher,DFMatcher manager;
    class CV,CvWrap classic;
    class Lazy,Base,Persistent learned;
    class Output,Info output;
